    function quickUpdateSupplyUnit(supplyId, newUnit) {
      const s = db.supplies.find(item => item.id === supplyId);
      if (!s || !newUnit) return;
      const oldUnit = s.unit;
      const conv = convertUnits(s.stock, oldUnit, newUnit);
      const convMin = convertUnits(s.minStock, oldUnit, newUnit);
      if (conv.compatible) {
        s.stock = conv.converted;
        s.minStock = convMin.converted;
      }
      s.unit = newUnit;
      saveDatabase();
      renderAll();
      showToast(`Unidad de ${s.code} cambiada de ${oldUnit} a ${newUnit}.`, 'success');
    }

    function quickUpdateSupplyStock(supplyId, newStockVal) {
      const s = db.supplies.find(item => item.id === supplyId);
      if (!s) return;
      const val = Number(newStockVal);
      if (isNaN(val) || val < 0) {
        renderSuppliesTable();
        return;
      }
      const prev = Number(s.stock);
      if (prev === val) return;
      s.stock = val;
      const cat = getCategoryById(s.categoryId);
      db.movements.unshift({
        id: 'mov-' + Date.now(),
        code: `AJU-${String(db.movements.length + 1).padStart(4, '0')}`,
        timestamp: new Date().toISOString().slice(0, 16).replace('T', ' '),
        type: 'AJUSTE',
        supplyId: s.id,
        supplyCode: s.code,
        supplyName: s.name,
        categoryName: cat.name,
        inputQty: val,
        inputUnit: s.unit,
        baseDelta: Number((val - prev).toFixed(6)),
        baseUnit: s.unit,
        prevStock: prev,
        newStock: val,
        areaId: db.areas[0]?.id || 'area-lab',
        areaName: 'Almacén Central IBS',
        userId: db.users[0]?.id || 'usr-1',
        userName: 'Ajuste Directo en Tabla',
        productTarget: 'Actualización rápida de stock en tabla',
        lot: s.lot || 'S/L',
        notes: ''
      });
      saveDatabase();
      renderAll();
      showToast(`Stock de ${s.code} actualizado a ${formatNumber(val)} ${s.unit}.`, 'success');
    }

    function handleQuickInlineRequisition(event) {
      event.preventDefault();
      const nameInput = document.getElementById('quickReqNameInput').value.trim();
      const qty = Number(document.getElementById('quickReqQtyInput').value);
      const unit = document.getElementById('quickReqUnitSelect').value;
      const urgency = document.getElementById('quickReqUrgencySelect').value;
      const areaId = document.getElementById('quickReqAreaSelect').value;
      const reason = document.getElementById('quickReqReasonInput').value.trim() || 'Solicitud rápida de abastecimiento para operaciones IBS';
      if (!nameInput || !qty || qty <= 0) return;

      const matchedSup = db.supplies.find(s => s.name.toLowerCase() === nameInput.toLowerCase() || s.code.toLowerCase() === nameInput.toLowerCase());
      const prefix = urgency === 'URGENTE' ? 'REQ-URG' : urgency === 'ALTA' ? 'REQ-ALT' : 'REQ-NOR';
      const code = `${prefix}-${String(db.requisitions.length + 1).padStart(3, '0')}`;
      const area = getAreaById(areaId);
      const areaUser = db.users.find(u => u.areaId === areaId) || db.users[0] || { id: 'usr-1', name: 'Personal IBS' };

      db.requisitions.unshift({
        id: 'req-' + Date.now(),
        code,
        date: new Date().toISOString().slice(0, 10),
        urgency,
        supplyId: matchedSup ? matchedSup.id : null,
        supplyCode: matchedSup ? matchedSup.code : `INS-${String(db.supplies.length + 1).padStart(3, '0')}`,
        supplyName: matchedSup ? matchedSup.name : nameInput,
        qty,
