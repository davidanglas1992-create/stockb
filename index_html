    function getUnitMeta(symbol) {
      return db.units.find(u => u.symbol === symbol) || { symbol, label: symbol, dimension: 'CUSTOM', factorToBase: 1 };
    }

    function convertUnits(qty, fromSymbol, toSymbol) {
      const q = Number(qty);
      if (isNaN(q)) return { converted: 0, compatible: false };
      if (fromSymbol === toSymbol) {
        return { converted: q, compatible: true, factor: 1 };
      }
      const fromMeta = getUnitMeta(fromSymbol);
      const toMeta = getUnitMeta(toSymbol);
      if (
        fromMeta.dimension &&
        fromMeta.dimension === toMeta.dimension &&
        (fromMeta.dimension === 'MASS' || fromMeta.dimension === 'VOLUME')
      ) {
        const inBase = q * fromMeta.factorToBase;
        const converted = Number((inBase / toMeta.factorToBase).toFixed(6));
        return { converted, compatible: true, factor: fromMeta.factorToBase / toMeta.factorToBase };
      }
      return { converted: q, compatible: false, factor: 1 };
    }

    function getExpiryStatus(expiryDateStr) {
      if (!expiryDateStr) return { status: 'NONE', label: 'Sin fecha', badgeClass: 'bg-slate-100 text-slate-600' };
      const now = new Date('2026-10-16T00:00:00');
      const exp = new Date(expiryDateStr + 'T00:00:00');
      const diffDays = Math.ceil((exp - now) / (1000 * 60 * 60 * 24));
      if (diffDays < 0) {
        return { status: 'EXPIRED', label: `Vencido (${expiryDateStr})`, badgeClass: 'bg-rose-100 text-rose-800 border border-rose-300 font-bold' };
      }
      if (diffDays <= 45) {
        return { status: 'SOON', label: `Vence en ${diffDays}d (${expiryDateStr})`, badgeClass: 'bg-amber-100 text-amber-800 border border-amber-300 font-semibold' };
      }
      return { status: 'OK', label: expiryDateStr, badgeClass: 'bg-emerald-50 text-emerald-700' };
    }

