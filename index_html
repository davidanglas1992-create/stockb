              <span>${escapeHtml(c.name)}</span>
              <span class="text-[11px] opacity-75">(${count})</span>
            </button>
          `;
        }).join('');
      }

      const filtered = db.supplies.filter(s => {
        const cat = getCategoryById(s.categoryId);
        const matchesSearch = !search ||
          s.code.toLowerCase().includes(search) ||
          s.name.toLowerCase().includes(search) ||
          (s.lot && s.lot.toLowerCase().includes(search)) ||
          (s.storage && s.storage.toLowerCase().includes(search)) ||
          cat.name.toLowerCase().includes(search);

        const matchesCat = catFilter === 'ALL' || s.categoryId === catFilter;

        const isLow = Number(s.stock) <= Number(s.minStock);
        const exp = getExpiryStatus(s.expiry);
        let matchesStatus = true;
        if (statusFilter === 'LOW') matchesStatus = isLow;
        if (statusFilter === 'OK') matchesStatus = !isLow;
        if (statusFilter === 'EXPIRING') matchesStatus = exp.status === 'EXPIRED' || exp.status === 'SOON';

        return matchesSearch && matchesCat && matchesStatus;
