    function getFilteredKardexMovements() {
      const q = (document.getElementById('kardexSearchInput')?.value || '').trim().toLowerCase();
      const supId = document.getElementById('kardexSupplyFilter')?.value || 'ALL';
      const areaId = document.getElementById('kardexAreaFilter')?.value || 'ALL';
      const type = document.getElementById('kardexTypeFilter')?.value || 'ALL';

      return db.movements.filter(m => {
        const matchQ = !q ||
          m.code.toLowerCase().includes(q) ||
          m.supplyCode.toLowerCase().includes(q) ||
          m.supplyName.toLowerCase().includes(q) ||
          (m.productTarget && m.productTarget.toLowerCase().includes(q)) ||
          (m.lot && m.lot.toLowerCase().includes(q)) ||
          (m.userName && m.userName.toLowerCase().includes(q));
        const matchSup = supId === 'ALL' || m.supplyId === supId;
        const matchArea = areaId === 'ALL' || m.areaId === areaId;
        const matchType = type === 'ALL' || m.type === type;
        return matchQ && matchSup && matchArea && matchType;
      });
    }

