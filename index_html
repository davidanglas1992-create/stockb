      const existingInCat = db.supplies.filter(s => s.categoryId === categoryId).length;
      const code = `${cat.prefix}-${String(existingInCat + 1).padStart(3, '0')}`;
      const minStock = Math.max(Math.round(stock * 0.2), 10);
