    }

    function closeGoogleSitesModal() {
      document.getElementById('googleSitesModal')?.classList.add('hidden');
    }

    function copyCompleteHtmlForGoogleSites() {
      const fullHtml = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(fullHtml).then(() => {
            showToast('¡Código HTML copiado! Pégalo en Google Sites → Incorporar → Código de incorporación.', 'success');
          }).catch(() => {
            fallbackCopyText(fullHtml);
          });
        } else {
          fallbackCopyText(fullHtml);
        }
      } catch (e) {
        fallbackCopyText(fullHtml);
      }
    }

    function fallbackCopyText(text) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.left = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy');
        showToast('¡Código HTML copiado! Pégalo en Google Sites → Incorporar → Código de incorporación.', 'success');
      } catch (err) {
        showToast('Usa el botón de Descargar Página Web (.html) si el navegador bloqueó el portapapeles.', 'warning');
      }
      document.body.removeChild(ta);
    }

    function downloadStandaloneHtmlFile() {
      const fullHtml = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
      const blob = new Blob([fullHtml], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'ibs_stock.html';
      document.body.appendChild(a);
      a.click();
      setTimeout(() => {
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }, 200);
      showToast('Archivo ibs_stock.html descargado. Ábrelo con doble clic en tu navegador.', 'success');
    }

    async function initCanvasPageVault() {
      try {
        if (window.pageVault) {
          await window.pageVault.ready;
          const savedVault = await window.pageVault.load('ibs_stock.state');
          if (savedVault && Array.isArray(savedVault.supplies)) {
            const vaultRev = Number(savedVault.meta?.revision) || 0;
            const localRev = Number(db.meta?.revision) || 0;
            if (vaultRev >= localRev) {
              db = savedVault;
              syncEmbeddedScriptTag(db);
              try { localStorage.setItem(STORAGE_KEY, JSON.stringify(db)); } catch (e) {}
              renderAll();
            }
          }
          if (typeof window.pageVault.onRestore === 'function') {
            window.pageVault.onRestore((restored) => {
              if (restored && Array.isArray(restored.supplies)) {
                db = restored;
                syncEmbeddedScriptTag(db);
                renderAll();
              }
            });
          }
        }
      } catch (e) {}
    }

    window.addEventListener('DOMContentLoaded', () => {
      syncEmbeddedScriptTag(db);
      selectedSupplyId = db.supplies[0]?.id || null;
      renderAll();
      if (selectedSupplyId) {
        selectSupplyForMovement(selectedSupplyId);
      }
      initCanvasPageVault();
    });
  </script>

</body></html>
