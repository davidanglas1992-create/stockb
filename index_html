    function downloadExcelFallback(sheetsObj, fileName) {
      let html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel"><head><meta charset="UTF-8"></head><body>';
      Object.keys(sheetsObj).forEach(sheetName => {
        const rows = sheetsObj[sheetName];
        html += `<h2>${escapeHtml(sheetName)}</h2><table border="1">`;
        if (rows.length > 0) {
          const headers = Object.keys(rows[0]);
          html += '<tr>' + headers.map(h => `<th style="background:#0f766e;color:#fff">${escapeHtml(h)}</th>`).join('') + '</tr>';
          rows.forEach(r => {
            html += '<tr>' + headers.map(h => `<td>${escapeHtml(r[h])}</td>`).join('') + '</tr>';
          });
        }
        html += '</table><br/>';
      });
      html += '</body></html>';
      const blob = new Blob([html], { type: 'application/vnd.ms-excel' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = fileName.replace(/\.xlsx$/, '.xls');
      document.body.appendChild(a);
      a.click();
      setTimeout(() => {
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }, 200);
    }

