    function openNewRequisitionModal(preselectSupplyId = null) {
      const modal = document.getElementById('requisitionModal');
      if (!modal) return;
      populateAllSelects();

      const reqSupplySelect = document.getElementById('reqSupplySelect');
      reqSupplySelect.innerHTML = `<option value="NEW">-- Nuevo Insumo (No catalogado aún) --</option>` +
