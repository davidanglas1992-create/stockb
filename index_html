    function handleSaveUser(event) {
      event.preventDefault();
      const editId = document.getElementById('editUserId').value;
      const code = document.getElementById('userCodeInput').value.trim().toUpperCase();
      const name = document.getElementById('userNameInput').value.trim();
      const areaId = document.getElementById('userAreaSelect').value;
      const role = document.getElementById('userRoleInput').value.trim() || 'Especialista IBS';
      if (!code || !name || !areaId) return;

      const duplicate = db.users.find(u => u.id !== editId && u.code.toUpperCase() === code);
      if (duplicate) {
        showToast(`El código de usuario ${code} ya está en uso por ${duplicate.name}.`, 'error');
        return;
      }

      if (editId) {
        const u = db.users.find(item => item.id === editId);
        if (u) {
          u.code = code;
          u.name = name;
          u.areaId = areaId;
          u.role = role;
          // Propagate updated user name to movements & requisitions
          db.movements.forEach(m => {
            if (m.userId === u.id) m.userName = u.name;
          });
          db.requisitions.forEach(r => {
            if (r.userId === u.id) r.userName = u.name;
          });
          showToast(`Usuario ${code} (${name}) actualizado correctamente.`, 'success');
        }
      } else {
        db.users.push({
          id: 'usr-' + Date.now(),
          code,
          name,
          areaId,
          role
        });
        showToast(`Usuario ${code} ("${name}") registrado correctamente.`, 'success');
      }

      resetUserForm();
      saveDatabase();
      renderAll();
    }

