    function receiveRequisitionIntoStock(reqId) {
      const req = db.requisitions.find(r => r.id === reqId);
      if (!req || req.status === 'RECIBIDO') return;

      let supply = db.supplies.find(s => s.id === req.supplyId || s.code === req.supplyCode);
      if (!supply) {
        supply = {
          id: 'sup-' + Date.now(),
          code: req.supplyCode || `REA-${String(db.supplies.length + 1).padStart(3, '0')}`,
          name: req.supplyName,
          categoryId: db.categories[0]?.id || 'cat-rea',
          stock: 0,
          minStock: Math.round(req.qty * 0.25),
          unit: req.unit,
          lot: `L-REC-${new Date().toISOString().slice(5, 10).replace('-', '')}`,
          expiry: '2027-12-31',
          storage: 'Temp. Ambiente Seco (15-25°C)'
        };
        db.supplies.push(supply);
      }

      const conv = convertUnits(req.qty, req.unit, supply.unit);
      const addedBase = conv.compatible ? conv.converted : Number(req.qty);
      const prevStock = Number(supply.stock);
      const newStock = Number((prevStock + addedBase).toFixed(6));
      supply.stock = newStock;
      req.status = 'RECIBIDO';

      const cat = getCategoryById(supply.categoryId);
