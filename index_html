    function cycleSalesDispatchStatus(dispatchId) {
      const d = db.salesDispatches.find(item => item.id === dispatchId);
      if (!d) return;
      const order = ['PROGRAMADO', 'EN RUTA', 'ENTREGADO'];
      const idx = order.indexOf(d.status);
      d.status = order[(idx + 1) % order.length];
      saveDatabase();
      renderAll();
      showToast(`Estado de ${d.code} cambiado a ${d.status}.`, 'success');
    }

