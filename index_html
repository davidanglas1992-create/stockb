<html lang="es"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IBS Stock — Sistema de Logística y Kardex Biotecnológico</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;family=JetBrains+Mono:wght@400;500;600&amp;display=swap" rel="stylesheet">
  <style>
    :root {
      --ibs-petrol: #00616D;
      --ibs-petrol-dark: #00444D;
      --ibs-petrol-deep: #002E35;
      --ibs-leaf: #63B617;
      --ibs-leaf-dark: #4E9310;
      --ibs-leaf-soft: #eef8e3;
      --ibs-surface: #f2f7f7;
    }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background-color: var(--ibs-surface);
      color: #0b252a;
    }
    .font-mono-code {
      font-family: 'JetBrains Mono', monospace;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #eaf2f2;
    }
    ::-webkit-scrollbar-thumb {
      background: #99bfc4;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #00616D;
    }
    .ibs-header-bg {
      background: linear-gradient(135deg, #003740 0%, #005560 55%, #00616D 100%);
    }
    .ibs-nav-bg {
      background-color: #00282F;
    }
    .ibs-hero-banner {
      background: linear-gradient(125deg, #003B44 0%, #00616D 60%, #2b7a38 100%);
    }
    .tab-active {
      background: linear-gradient(135deg, #63B617 0%, #4E9310 100%);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(99, 182, 23, 0.35);
    }
    .btn-ibs-leaf {
      background: linear-gradient(135deg, #63B617 0%, #4E9310 100%);
      color: #ffffff;
    }
    .btn-ibs-leaf:hover {
      background: linear-gradient(135deg, #6ec71c 0%, #58a513 100%);
    }
    .btn-ibs-petrol {
      background: linear-gradient(135deg, #00616D 0%, #004A54 100%);
      color: #ffffff;
    }
    .btn-ibs-petrol:hover {
      background: linear-gradient(135deg, #007482 0%, #005965 100%);
    }
    .modal-backdrop {
      background-color: rgba(0, 40, 47, 0.65);
      backdrop-filter: blur(3px);
    }
    .step-card {
      border-left: 4px solid #00616D;
      background: #ffffff;
    }
    .step-card-green {
      border-left: 4px solid #63B617;
      background: #ffffff;
    }
    .step-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 2px 9px;
      border-radius: 9999px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }
    .quick-pill {
      padding: 4px 10px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 600;
      border: 1px solid #cbd5e1;
      background: #f8fafc;
      color: #1e293b;
      transition: all 0.15s ease;
      cursor: pointer;
    }
    .quick-pill:hover {
      border-color: #00616D;
      background: #e6f4f5;
      color: #00444D;
    }
    .quick-pill-active {
      border-color: #63B617 !important;
      background: #eef8e3 !important;
      color: #2f5e07 !important;
      font-weight: 700;
    }
    .nav-tab[data-step]::before {
      content: attr(data-step);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 20px;
      height: 20px;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.18);
      font-size: 11px;
      font-weight: 800;
      flex-shrink: 0;
    }
    .nav-tab.tab-active[data-step]::before {
      background: rgba(0, 0, 0, 0.25);
      color: #ffffff;
    }
  </style>
