    function handleSaveSupply(event) {
      event.preventDefault();
      const id = document.getElementById('supplyIdInput').value;
      const categoryId = document.getElementById('supplyCategorySelect').value;
      const code = document.getElementById('supplyCodeInput').value.trim().toUpperCase();
      const unit = document.getElementById('supplyUnitSelect').value;
      const name = document.getElementById('supplyNameInput').value.trim();
      const stock = Number(document.getElementById('supplyStockInput').value);
      const minStock = Number(document.getElementById('supplyMinStockInput').value);
      const lot = document.getElementById('supplyLotInput').value.trim();
      const expiry = document.getElementById('supplyExpiryInput').value;
      const storage = document.getElementById('supplyStorageInput').value;

      if (id) {
        const existing = db.supplies.find(s => s.id === id);
        if (existing) {
          existing.categoryId = categoryId;
          existing.code = code;
          existing.unit = unit;
          existing.name = name;
          existing.stock = stock;
          existing.minStock = minStock;
          existing.lot = lot;
          existing.expiry = expiry;
          existing.storage = storage;
          showToast(`Insumo ${code} actualizado.`, 'success');
        }
      } else {
        const newSup = {
          id: 'sup-' + Date.now(),
          code,
          name,
          categoryId,
          stock,
          minStock,
          unit,
          lot,
          expiry,
          storage
        };
        db.supplies.push(newSup);
        const cat = getCategoryById(categoryId);
        db.movements.unshift({
          id: 'mov-' + Date.now(),
          code: `ENT-${String(db.movements.length + 1).padStart(4, '0')}`,
          timestamp: new Date().toISOString().slice(0, 16).replace('T', ' '),
          type: 'ENTRADA',
          supplyId: newSup.id,
          supplyCode: newSup.code,
          supplyName: newSup.name,
          categoryName: cat.name,
          inputQty: stock,
          inputUnit: unit,
          baseDelta: stock,
          baseUnit: unit,
          prevStock: 0,
          newStock: stock,
          areaId: db.areas[0]?.id || 'area-lab',
          areaName: 'Almacén Central IBS',
          userId: db.users[0]?.id || 'usr-1',
          userName: 'Registro Inicial Almacén',
          productTarget: 'Inventario Inicial / Alta de Insumo',
          lot: lot || 'S/L',
          notes: `Alta en condición: ${storage}`
        });
        showToast(`Nuevo insumo ${code} (${name}) agregado al almacén y Kardex.`, 'success');
      }

      saveDatabase();
      closeSupplyModal();
      renderAll();
    }

