    function autoGenerateLowStockRequisitions() {
      const lowSupplies = db.supplies.filter(s => Number(s.stock) <= Number(s.minStock));
      let createdCount = 0;

      lowSupplies.forEach(s => {
        const alreadyOpen = db.requisitions.some(r => r.supplyId === s.id && r.status !== 'RECIBIDO');
        if (!alreadyOpen) {
          const code = `REQ-URG-${String(db.requisitions.length + 1).padStart(3, '0')}`;
          const needed = Math.max(Number(s.minStock) * 2 - Number(s.stock), Number(s.minStock) || 100);
          db.requisitions.unshift({
            id: 'req-' + Date.now() + '-' + createdCount,
            code,
            date: new Date().toISOString().slice(0, 10),
            urgency: 'URGENTE',
            supplyId: s.id,
            supplyCode: s.code,
            supplyName: s.name,
            qty: Number(needed.toFixed(2)),
            unit: s.unit,
            areaId: db.areas[0]?.id || 'area-lab',
            areaName: db.areas[0]?.name || 'Laboratorio',
            userId: db.users[0]?.id || 'usr-1',
            userName: db.users[0]?.name || 'Blga. Elena Vargas',
            reason: `Generado automáticamente por stock crítico (${formatNumber(s.stock)} ${s.unit} <= Mín ${formatNumber(s.minStock)} ${s.unit})`,
            status: 'PENDIENTE'
          });
          createdCount++;
        }
      });

      saveDatabase();
      renderAll();
      if (createdCount > 0) {
        showToast(`Se generaron ${createdCount} requerimientos urgentes para insumos en stock crítico.`, 'success');
      } else {
        showToast('Todos los insumos con stock bajo ya cuentan con un requerimiento de compra activo.', 'warning');
      }
    }

