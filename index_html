      event.preventDefault();
      const editId = document.getElementById('editSalesDispatchId').value;
      const code = document.getElementById('salesCodeInput').value.trim().toUpperCase();
      const clientName = document.getElementById('salesClientInput').value.trim();
      const deliveryDate = document.getElementById('salesDeliveryDateInput').value;
      const productId = document.getElementById('salesProductCatalogSelect').value;
      const productName = document.getElementById('salesProductNameInput').value.trim();
      const presentation = document.getElementById('salesPresentationInput').value.trim();
