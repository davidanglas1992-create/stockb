    function handleMovementSubmit(event) {
      event.preventDefault();
      const supply = db.supplies.find(s => s.id === selectedSupplyId);
      if (!supply) {
        showToast('Primero selecciona un insumo buscándolo por código o nombre.', 'error');
        document.getElementById('fastSearchInput').focus();
        return;
      }

      const qty = Number(document.getElementById('movQuantity').value);
      const chosenUnit = document.getElementById('movUnitSelect').value;
      const updateBase = document.getElementById('chkUpdateBaseUnit').checked;
      const areaId = document.getElementById('movAreaSelect').value;
      const userId = document.getElementById('movUserSelect').value;
      const productTarget = document.getElementById('movProductTarget').value.trim();
      const lotUsed = document.getElementById('movLotUsed').value.trim() || supply.lot || 'S/L';
      const notes = document.getElementById('movNotes').value.trim();

      if (!qty || qty <= 0) {
        showToast('Ingresa una cantidad válida mayor a cero.', 'error');
        return;
      }

      if (updateBase && chosenUnit !== supply.unit) {
        const convStock = convertUnits(supply.stock, supply.unit, chosenUnit);
        const convMin = convertUnits(supply.minStock, supply.unit, chosenUnit);
        if (convStock.compatible) {
          supply.stock = convStock.converted;
          supply.minStock = convMin.converted;
        }
        supply.unit = chosenUnit;
      }

      const conv = convertUnits(qty, chosenUnit, supply.unit);
      const deltaInBase = conv.compatible ? conv.converted : qty;
      const prevStock = Number(supply.stock);
      let newStock = prevStock;
      let signedDelta = 0;

      if (currentMovementType === 'SALIDA') {
        if (deltaInBase > prevStock) {
          showToast(`Stock insuficiente en almacén (${formatNumber(prevStock)} ${supply.unit}). Genera un Requerimiento de Compra Urgente o ingresa stock.`, 'error');
          return;
        }
        newStock = Number((prevStock - deltaInBase).toFixed(6));
        signedDelta = -deltaInBase;
      } else if (currentMovementType === 'ENTRADA') {
        newStock = Number((prevStock + deltaInBase).toFixed(6));
        signedDelta = deltaInBase;
      } else {
        newStock = Number(deltaInBase.toFixed(6));
        signedDelta = Number((newStock - prevStock).toFixed(6));
      }

      supply.stock = newStock;
      if (lotUsed) supply.lot = lotUsed;

      const area = getAreaById(areaId);
      const user = getUserById(userId);
      const cat = getCategoryById(supply.categoryId);
      const prefix = currentMovementType === 'SALIDA' ? 'SAL' : currentMovementType === 'ENTRADA' ? 'ENT' : 'AJU';
      const nextNum = String(db.movements.length + 1).padStart(4, '0');
      const nowStr = new Date().toISOString().slice(0, 16).replace('T', ' ');

      const movRecord = {
        id: 'mov-' + Date.now(),
        code: `${prefix}-${nextNum}`,
        timestamp: nowStr,
        type: currentMovementType,
        supplyId: supply.id,
        supplyCode: supply.code,
        supplyName: supply.name,
        categoryName: cat.name,
        inputQty: qty,
        inputUnit: chosenUnit,
        baseDelta: signedDelta,
        baseUnit: supply.unit,
        prevStock: prevStock,
        newStock: newStock,
        areaId: area.id,
        areaName: area.name,
        userId: user.id,
        userName: user.name,
        productTarget: productTarget,
        lot: lotUsed,
        notes: notes
      };

      db.movements.unshift(movRecord);
      saveDatabase();
      renderAll();

      document.getElementById('movQuantity').value = '';
      document.getElementById('movProductTarget').value = '';
      document.getElementById('movNotes').value = '';
      document.getElementById('chkUpdateBaseUnit').checked = false;
      updateUnitConversionPreview();

      if (newStock <= Number(supply.minStock)) {
        showToast(`Movimiento ${movRecord.code} registrado. ¡Atención! ${supply.name} quedó en stock bajo (${formatNumber(newStock)} ${supply.unit}).`, 'warning');
      } else {
        showToast(`Movimiento ${movRecord.code} registrado en Kardex (${formatNumber(qty)} ${chosenUnit} de ${supply.code}).`, 'success');
      }
    }

