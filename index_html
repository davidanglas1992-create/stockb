    function rowsToCsvBom(rows) {
      if (!rows || rows.length === 0) return '';
      const headers = Object.keys(rows[0]);
      const esc = (v) => '"' + String(v ?? '').replace(/"/g, '""') + '"';
      const lines = [headers.map(esc).join(',')];
      rows.forEach(r => {
        lines.push(headers.map(h => esc(r[h])).join(','));
      });
      return '\uFEFF' + lines.join('\r\n');
    }

    function downloadSingleNotionCsv(kind) {
      let rows = [];
      let filename = 'IBS_Notion.csv';
      if (kind === 'INSUMOS') {
        rows = buildCatalogRows();
        filename = '1_Inventario_Insumos.csv';
      } else if (kind === 'KARDEX') {
        rows = buildKardexRows(db.movements);
        filename = '2_Kardex_Movimientos.csv';
      } else if (kind === 'VENTAS') {
        rows = buildSalesDispatchesRows();
        filename = '3_Salidas_Productos_Ventas.csv';
      } else if (kind === 'COMPRAS') {
        rows = buildRequisitionsRows();
        filename = '4_Requerimientos_Compra.csv';
      } else if (kind === 'USUARIOS') {
        rows = buildAreasUsersRows();
        filename = '5_Areas_y_Usuarios.csv';
      }
      const csvContent = rowsToCsvBom(rows);
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(url); }, 200);
      showToast(`Archivo ${filename} descargado para importar en Notion.`, 'success');
    }

