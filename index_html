    function handleReqSupplySelectChange() {
      const val = document.getElementById('reqSupplySelect').value;
      if (val === 'NEW') {
        document.getElementById('reqSupplyNameInput').value = '';
        document.getElementById('reqSupplyCodeRef').value = `INS-${String(db.supplies.length + 1).padStart(3, '0')}`;
        document.getElementById('reqQtyInput').value = '';
        return;
      }
      const s = db.supplies.find(item => item.id === val);
      if (!s) return;
      document.getElementById('reqSupplyNameInput').value = s.name;
      document.getElementById('reqSupplyCodeRef').value = s.code;
      document.getElementById('reqUnitInput').value = s.unit;
      const suggested = Math.max(Number(s.minStock) * 2 - Number(s.stock), Number(s.minStock) || 100);
      document.getElementById('reqQtyInput').value = Number(suggested.toFixed(2));
