    function escapeHtml(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function formatNumber(num) {
      const n = Number(num);
      if (isNaN(n)) return '0';
      if (Math.abs(n) >= 100 || Number.isInteger(n)) {
        return n.toLocaleString('es-PE', { maximumFractionDigits: 3 });
      }
      return n.toLocaleString('es-PE', { maximumFractionDigits: 4 });
    }

