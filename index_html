    function suggestUserCode() {
      const editId = document.getElementById('editUserId')?.value;
      if (editId) return;
      const codeInput = document.getElementById('userCodeInput');
      if (!codeInput) return;
      const areaId = document.getElementById('userAreaSelect')?.value;
      const area = getAreaById(areaId);
      const prefix = area && area.code ? area.code.toUpperCase() : 'USR';
      const countInArea = db.users.filter(u => u.areaId === areaId).length + 1;
      let candidate = `${prefix}-${String(countInArea).padStart(2, '0')}`;
      let seq = countInArea;
      while (db.users.some(u => u.code.toUpperCase() === candidate)) {
        seq++;
        candidate = `${prefix}-${String(seq).padStart(2, '0')}`;
      }
      codeInput.value = candidate;
    }

