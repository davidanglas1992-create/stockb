    function quickUpdateUserCode(userId, newCodeRaw) {
      const user = db.users.find(u => u.id === userId);
      if (!user) return;
      const cleanCode = (newCodeRaw || '').trim().toUpperCase();
      if (!cleanCode) {
        renderUsersList();
        showToast('El código de usuario no puede estar vacío.', 'error');
        return;
      }
      const duplicate = db.users.find(u => u.id !== userId && u.code.toUpperCase() === cleanCode);
      if (duplicate) {
        renderUsersList();
        showToast(`El código ${cleanCode} ya pertenece a ${duplicate.name}.`, 'error');
        return;
      }
      const oldCode = user.code;
      user.code = cleanCode;
      saveDatabase();
      renderAll();
      showToast(`Código de ${user.name} actualizado de ${oldCode} a ${cleanCode}.`, 'success');
    }

