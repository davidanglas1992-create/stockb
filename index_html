      if (!tbody) return;

      const search = (document.getElementById('catalogSearchInput')?.value || '').trim().toLowerCase();
      const catFilter = document.getElementById('catalogCategoryFilter')?.value || 'ALL';
      const statusFilter = document.getElementById('catalogStatusFilter')?.value || 'ALL';

      if (pillsBar) {
        pillsBar.innerHTML = db.categories.map(c => {
          const count = db.supplies.filter(s => s.categoryId === c.id).length;
          return `
            <button
              onclick="filterCatalogByCategory('${escapeHtml(c.id)}')"
              class="px-3 py-1.5 rounded-xl text-xs font-semibold border transition whitespace-nowrap flex items-center gap-1.5 ${catFilter === c.id ? 'bg-teal-600 text-white border-teal-600' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50'}"
