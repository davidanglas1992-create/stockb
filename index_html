    function handleSaveCatalogProduct(event) {
      event.preventDefault();
      const editId = document.getElementById('editCatProdId').value;
      const code = document.getElementById('catProdCodeInput').value.trim().toUpperCase();
      const name = document.getElementById('catProdNameInput').value.trim();
      const presentation = document.getElementById('catProdPresInput').value.trim();
      const unitWeight = Number(document.getElementById('catProdWeightInput').value) || 1;
      const weightUnit = document.getElementById('catProdUnitInput').value;

      if (editId) {
        const p = db.salesCatalog.find(item => item.id === editId);
        if (p) {
          p.code = code;
          p.name = name;
          p.presentation = presentation;
          p.unitWeight = unitWeight;
          p.weightUnit = weightUnit;
          showToast(`Producto "${name}" actualizado en el catálogo.`, 'success');
        }
      } else {
        db.salesCatalog.push({
          id: 'prd-' + Date.now(),
          code,
          name,
          presentation,
          unitWeight,
          weightUnit
        });
        showToast(`Producto "${name}" agregado al catálogo de ventas.`, 'success');
      }
      document.getElementById('editCatProdId').value = '';
      toggleNewCatalogProductBox(false);
      saveDatabase();
      renderAll();
    }

    function saveCurrentProductToCatalog() {
      const name = document.getElementById('salesProductNameInput').value.trim();
      const presentation = document.getElementById('salesPresentationInput').value.trim();
      const weightVal = Number(document.getElementById('salesWeightValueInput').value) || 1;
      const packQty = Number(document.getElementById('salesPackQtyInput').value) || 1;
      const weightUnit = document.getElementById('salesWeightUnitInput').value;

      if (!name || !presentation) {
        showToast('Completa primero el nombre del producto y la presentación para guardarlo en el catálogo.', 'warning');
        return;
      }

      const unitWeight = Number((weightVal / packQty).toFixed(3)) || 1;
      const existing = db.salesCatalog.find(p => p.name.toLowerCase() === name.toLowerCase() && p.presentation.toLowerCase() === presentation.toLowerCase());
      if (existing) {
        existing.unitWeight = unitWeight;
        existing.weightUnit = weightUnit;
        showToast(`Se actualizaron los datos de "${name}" en el catálogo.`, 'success');
      } else {
        const newProd = {
          id: 'prd-' + Date.now(),
          code: `PRD-${String(db.salesCatalog.length + 1).padStart(3, '0')}`,
          name,
          presentation,
          unitWeight,
          weightUnit
        };
        db.salesCatalog.push(newProd);
        showToast(`Producto "${name}" (${presentation}) guardado en el catálogo de ventas.`, 'success');
      }
      saveDatabase();
      renderAll();
    }

