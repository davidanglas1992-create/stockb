    function loadDatabase() {
      const seed = getSeedData();
      let candidate = seed;
      let maxRev = Number(seed.meta?.revision) || 1;

      try {
        const embEl = document.getElementById('ibsEmbeddedState');
        if (embEl && embEl.textContent && embEl.textContent.trim().startsWith('{')) {
          const embParsed = JSON.parse(embEl.textContent.trim());
          const embRev = Number(embParsed?.meta?.revision) || 0;
          if (embParsed && Array.isArray(embParsed.supplies) && embRev >= maxRev) {
            if (!Array.isArray(embParsed.salesCatalog)) embParsed.salesCatalog = seed.salesCatalog;
            if (!Array.isArray(embParsed.salesDispatches)) embParsed.salesDispatches = seed.salesDispatches;
            candidate = embParsed;
            maxRev = embRev;
          }
        }
      } catch (e) {}

      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          const localRev = Number(parsed?.meta?.revision) || 1;
          if (parsed && Array.isArray(parsed.supplies) && Array.isArray(parsed.areas) && localRev >= maxRev) {
            if (!Array.isArray(parsed.salesCatalog)) parsed.salesCatalog = seed.salesCatalog;
            if (!Array.isArray(parsed.salesDispatches)) parsed.salesDispatches = seed.salesDispatches;
            candidate = parsed;
            maxRev = localRev;
          }
        }
      } catch (e) {
        console.warn('Almacenamiento local restringido, usando memoria activa.');
      }
      return candidate;
    }

    function saveDatabase() {
      if (!db.meta) db.meta = { revision: 1, lastUpdated: new Date().toISOString() };
      db.meta.revision = (Number(db.meta.revision) || 1) + 1;
      db.meta.lastUpdated = new Date().toISOString();
      syncEmbeddedScriptTag(db);
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(db));
      } catch (e) {
        console.warn('No se pudo persistir en localStorage:', e);
      }
      try {
        if (window.pageVault && typeof window.pageVault.save === 'function') {
          window.pageVault.save('ibs_stock.state', db);
        }
      } catch (e) {}
      try {
        if (syncChannel) syncChannel.postMessage({ type: 'DB_UPDATED', db });
      } catch (e) {}
    }

    if (syncChannel) {
      syncChannel.onmessage = (ev) => {
        if (ev.data && ev.data.type === 'DB_UPDATED' && ev.data.db) {
          const incoming = ev.data.db;
          if (Number(incoming.meta?.revision || 0) > Number(db.meta?.revision || 0)) {
            db = incoming;
            syncEmbeddedScriptTag(db);
            renderAll();
