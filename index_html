    function updateUnitConversionPreview() {
      const notice = document.getElementById('unitConversionNotice');
      const qtyInput = document.getElementById('movQuantity');
      const unitSelect = document.getElementById('movUnitSelect');
      const chkBase = document.getElementById('chkUpdateBaseUnit');
      if (!notice || !qtyInput || !unitSelect) return;

      const supply = db.supplies.find(s => s.id === selectedSupplyId);
      const qty = Number(qtyInput.value);
      const chosenUnit = unitSelect.value;

      if (!supply) {
        notice.innerHTML = `Selecciona un insumo arriba para calcular la equivalencia en <strong>${escapeHtml(chosenUnit)}</strong>.`;
        return;
      }

      if (!qty || qty <= 0) {
        notice.innerHTML = `Unidad base del insumo en almacén: <strong>${escapeHtml(supply.unit)}</strong>. Puedes despachar en <strong>${escapeHtml(chosenUnit)}</strong> o cualquier otra medida.`;
        return;
      }

      if (chkBase && chkBase.checked) {
        const conv = convertUnits(supply.stock, supply.unit, chosenUnit);
        if (conv.compatible) {
          notice.innerHTML = `<span class="text-teal-700 font-semibold">Cambio de unidad base activo:</span> El stock actual (${formatNumber(supply.stock)} ${escapeHtml(supply.unit)}) pasará a expresarse en <strong>${formatNumber(conv.converted)} ${escapeHtml(chosenUnit)}</strong> y se operarán <strong>${formatNumber(qty)} ${escapeHtml(chosenUnit)}</strong>.`;
        } else {
          notice.innerHTML = `<span class="text-amber-700 font-semibold">Cambio de unidad base directo:</span> La unidad de control del insumo cambiará de ${escapeHtml(supply.unit)} a <strong>${escapeHtml(chosenUnit)}</strong>.`;
        }
        return;
      }

      const conv = convertUnits(qty, chosenUnit, supply.unit);
      if (chosenUnit === supply.unit) {
        const resulting = currentMovementType === 'SALIDA'
          ? Number(supply.stock) - qty
          : currentMovementType === 'ENTRADA'
            ? Number(supply.stock) + qty
            : qty;
        notice.innerHTML = `Movimiento directo: <strong>${formatNumber(qty)} ${escapeHtml(chosenUnit)}</strong> → Saldo resultante en Kardex: <strong>${formatNumber(resulting)} ${escapeHtml(supply.unit)}</strong>.`;
      } else if (conv.compatible) {
        const resulting = currentMovementType === 'SALIDA'
          ? Number(supply.stock) - conv.converted
          : currentMovementType === 'ENTRADA'
            ? Number(supply.stock) + conv.converted
            : conv.converted;
        notice.innerHTML = `<span class="text-teal-700 font-semibold">Conversión automática:</span> <strong>${formatNumber(qty)} ${escapeHtml(chosenUnit)}</strong> equivale a <strong>${formatNumber(conv.converted)} ${escapeHtml(supply.unit)}</strong>. Saldo resultante: <strong>${formatNumber(resulting)} ${escapeHtml(supply.unit)}</strong>.`;
      } else {
        notice.innerHTML = `<span class="text-amber-700 font-semibold">Medida distinta (${escapeHtml(chosenUnit)} vs ${escapeHtml(supply.unit)}):</span> Se descontará/sumará numéricamente ${formatNumber(qty)} sobre el stock o marca la casilla de la derecha para actualizar la unidad del insumo a <strong>${escapeHtml(chosenUnit)}</strong>.`;
      }
    }

