    function renderSalesDispatchesTable() {
      const tbody = document.getElementById('salesDispatchesTableBody');
      if (!tbody) return;
      const q = (document.getElementById('salesSearchInput')?.value || '').trim().toLowerCase();
      const st = document.getElementById('salesStatusFilter')?.value || 'ALL';

      const list = (db.salesDispatches || []).filter(d => {
        const matchQ = !q ||
          d.code.toLowerCase().includes(q) ||
          d.clientName.toLowerCase().includes(q) ||
          d.productName.toLowerCase().includes(q) ||
          d.presentation.toLowerCase().includes(q) ||
          (d.batch && d.batch.toLowerCase().includes(q));
        const matchSt = st === 'ALL' || d.status === st;
        return matchQ && matchSt;
      });

      if (list.length === 0) {
        tbody.innerHTML = `<tr><td colspan="10" class="py-8 text-center text-slate-400">No se encontraron salidas de productos con los filtros actuales.</td></tr>`;
        return;
      }

      tbody.innerHTML = list.map(d => {
        const stBadge = d.status === 'ENTREGADO'
          ? 'bg-emerald-100 text-emerald-800 border border-emerald-300'
          : d.status === 'EN RUTA'
            ? 'bg-amber-100 text-amber-800 border border-amber-300'
            : 'bg-indigo-50 text-indigo-700 border border-indigo-200';
        return `
          <tr class="hover:bg-slate-50/90 transition">
            <td class="py-3 px-4 font-mono-code font-bold text-indigo-900">${escapeHtml(d.code)}</td>
            <td class="py-3 px-4 font-semibold text-slate-800 whitespace-nowrap">${escapeHtml(d.deliveryDate)}</td>
            <td class="py-3 px-4">
              <div class="font-bold text-slate-900">${escapeHtml(d.clientName)}</div>
              ${d.notes ? `<div class="text-[11px] text-slate-500">${escapeHtml(d.notes)}</div>` : ''}
            </td>
            <td class="py-3 px-4 font-bold text-teal-800">${escapeHtml(d.productName)}</td>
            <td class="py-3 px-4">
              <span class="px-2.5 py-0.5 rounded-lg text-xs font-medium bg-slate-100 text-slate-800">${escapeHtml(d.presentation)}</span>
            </td>
            <td class="py-3 px-4 text-right font-bold text-slate-900 whitespace-nowrap">
              ${formatNumber(d.packQty)} <span class="text-indigo-700">${escapeHtml(d.packType)}</span>
            </td>
            <td class="py-3 px-4 text-right font-mono-code font-bold text-slate-900 whitespace-nowrap">
              ${formatNumber(d.weightValue)} ${escapeHtml(d.weightUnit)}
            </td>
            <td class="py-3 px-4">
              <span class="font-mono-code text-[11px] text-slate-700 block">${escapeHtml(d.batch || 'S/L')}</span>
              <span class="text-[11px] text-slate-500">${escapeHtml(d.userName || '')}</span>
            </td>
            <td class="py-3 px-4">
              <button
                type="button"
                onclick="cycleSalesDispatchStatus('${escapeHtml(d.id)}')"
                title="Haz clic para cambiar el estado de entrega"
                class="px-2.5 py-0.5 rounded-full text-[10px] font-bold ${stBadge} hover:opacity-80 transition"
              >
                ${escapeHtml(d.status)}
              </button>
            </td>
            <td class="py-3 px-4 text-right whitespace-nowrap space-x-1">
              <button
                type="button"
                onclick="editSalesDispatch('${escapeHtml(d.id)}')"
