      const weightValue = Number(document.getElementById('salesWeightValueInput').value);
      const weightUnit = document.getElementById('salesWeightUnitInput').value;
      const batch = document.getElementById('salesBatchInput').value.trim() || `LOTE-IBS-${new Date().toISOString().slice(5, 10).replace('-', '')}`;
      const status = document.getElementById('salesStatusInput').value;
      const userId = document.getElementById('salesUserSelect').value;
      const user = getUserById(userId);
      const notes = document.getElementById('salesNotesInput').value.trim();

      if (!clientName || !productName || !presentation || !packQty || !weightValue) {
        showToast('Completa los datos de cliente, producto, presentación, cantidad y peso.', 'error');
        return;
      }

      if (editId) {
        const rec = db.salesDispatches.find(d => d.id === editId);
        if (rec) {
          rec.code = code;
          rec.clientName = clientName;
          rec.deliveryDate = deliveryDate;
          rec.productId = productId === 'CUSTOM' ? null : productId;
          rec.productName = productName;
          rec.presentation = presentation;
          rec.packQty = packQty;
          rec.packType = packType;
          rec.weightValue = weightValue;
          rec.weightUnit = weightUnit;
          rec.batch = batch;
          rec.status = status;
          rec.userId = user.id;
          rec.userName = user.name;
          rec.notes = notes;
          showToast(`Salida de producto ${code} para "${clientName}" modificada correctamente.`, 'success');
        }
      } else {
        db.salesDispatches.unshift({
          id: 'dsp-' + Date.now(),
          code,
          deliveryDate,
          clientName,
          productId: productId === 'CUSTOM' ? null : productId,
          productName,
          presentation,
          packQty,
          packType,
          weightValue,
          weightUnit,
          batch,
          status,
          userId: user.id,
          userName: user.name,
          notes
